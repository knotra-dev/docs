{
  "name": "knotra-docs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter knotra-docs-web dev",
    "build": "bun run --filter knotra-docs-web build",
    "lint": "bun run --filter knotra-docs-web lint",
    "typecheck": "bun run --filter knotra-docs-web typecheck",
    "test": "bun test tests/*.test.mjs"
  },
  "devDependencies": {},
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=24 <25"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "contentlayer2",
    "esbuild",
    "protobufjs"
  ]
}
